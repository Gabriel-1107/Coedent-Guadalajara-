---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
const metadata = {
  title: 'Consultorio Dental MG',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline=""
    actions={[
      // { variant: 'primary', target: '_blank', text: 'Get Started', href: 'https://github.com/onwidget/astrowind' },
      // { text: 'Learn more', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/dentista1.jpg',
      alt: 'Dentista1',
    }}
  >
    <Fragment slot="title">
      <br />  <span class="text-accent dark:text-white highlight"
        >Dental </span
      >Consultorio MG<br />
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Desde limpiezas regulares hasta tratamientos especializados, nuestros especialistas altamente calificados están listos para ofrecerte una experiencia dental excepcional que te hará sonreír.
 <span class="font-semibold"></span></span
      >
      
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="Servicios"
    subtitle=""
    columns={2}
    items={[
      {
        title: 'Limpieza dental profesional',
        description: 'Eliminación de placa, sarro y manchas para prevenir enfermedades bucales.',
        icon: 'tabler:apple',
      },
      {
        title: 'Tratamiento de caries',
        description: `Rellenos para reparar dientes dañados por caries, utilizando materiales como resina, amalgama o porcelana.`,
        icon: 'tabler:accessible',
      },
      {
        title: 'Blanqueamiento dental',
        description: 'Técnicas para aclarar el color de los dientes, mejorando la estética de la sonrisa.',
        icon: 'tabler:apple',
      },
      {
        title: 'Ortodoncia',
        description: `Corrección de maloclusiones y alineación dental mediante brackets, alineadores`,
        icon: 'tabler:mood-happy',
      },
      {
        title: 'Estética dental',
        description: 'Procedimientos como carillas, incrustaciones y remodelación dental para mejorar la apariencia de los dientes.',
        icon: 'tabler:apple',
      },
      {
        title: 'Extracciones dentales',
        description: 'Retiro de dientes dañados, infectados o que causan problemas, incluyendo muelas del juicio.',
        icon: 'tabler:apple',
      },
      
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline=""
    title="Por qué elegirnos"
    items={[
      {
        title: 'Atención personalizada',
        description: 'Cada paciente es único. Diseñamos tratamientos adaptados a tus necesidades específicas para garantizar resultados sobresalientes.',
      },
      {
        title: 'Experiencia comprobada',
        description: 'Más de 10 años cuidando sonrisas con profesionalismo y dedicación.',
      },
      {
        title: 'Equipo altamente capacitado',
        description: 'Nuestro personal está formado por especialistas en diferentes áreas de la odontología.',
      },
      {
        title: 'Tecnología de última generación',
        description: 'Utilizamos equipos avanzados para garantizar diagnósticos precisos y tratamientos efectivos.',
      },
    ]}
    image={{
      src: '~/assets/images/dentista3.jpg',
      alt: 'Colorful Image',
    }}
  >
    <!-- <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Building on modern foundations</h3>
      Gain a competitive advantage by incorporating industry leading practices
    </Fragment> -->

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Ambiente cómodo y seguro',
        description: `Cuidamos cada detalle para que tu visita sea lo más agradable y relajada posible.`,
      },
      {
        title: 'Tratamientos integrales',
        description: 'Ofrecemos servicios que van desde limpiezas dentales hasta implantes, todo en un mismo lugar.',
      },
      {
        title: 'Resultados estéticos excepcionales',
        description: "Nos enfocamos en ofrecer tratamientos que mejoren tanto tu salud dental como la belleza de tu sonrisa.",
      },
      {
        title: 'Compromiso con la salud bucal',
        description: 'Te educamos y acompañamos para mantener una sonrisa saludable durante toda tu vida.',
      },
    ]}
    image={{
      src: '~/assets/images/dentista2.jpg',
      alt: 'Blueprint Image',
    }}
  >
    <!-- <Fragment slot="content">Ensure your online presence truly represents you.</Fragment> -->

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

