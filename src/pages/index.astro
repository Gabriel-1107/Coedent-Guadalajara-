  <!-- Steps Widget ****************** -->

  <Steps
    title="¡Así de fácil es cuidar tu sonrisa!"
    items={[
      {
        title: 'Paso 1:  <span class="font-medium">Agenda tu cita</span>',
        description:
          "Contáctanos a través de nuestro sitio web, WhatsApp o por teléfono para reservar tu consulta en el horario que más te convenga.",
        icon: 'tabler:package',
      },
      {
        title: 'Paso 2: <span class="font-medium">Diagnóstico personalizado</span>',
        description:
          "En tu primera visita, realizaremos una evaluación completa para entender tus necesidades y diseñar un plan de tratamiento a tu medida.",
        icon: 'tabler:letter-case',
      },
      {
        title: 'Paso 3: <span class="font-medium">Customize styles</span>',
        description:
          'Comenzaremos con el cuidado necesario para mejorar tu salud bucal, utilizando tecnología avanzada y las mejores técnicas.',
        icon: 'tabler:paint',
      },
      {
        title: '¡Listo!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/dentista4.jpg',
      alt: 'Steps image',
    }}
  />

<!-- mapa -->
<WidgetWrapper> 
  <Headline 
   title= "Visitanos"
   subtitle=" "
   ></Headline>
  <!-- Contenedor del mapa y detalles -->
  <div class="section row pb-0">
      <!-- Mapa de Google Maps -->
      <iframe
        class="w-full h-80 md:h-96 rounded-lg shadow-lg"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d119549.26019171218!2d-103.43633805271175!3d20.5506837735985!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x842f4db5d59525b5%3A0x6007b74e6a48af67!2sDENTAL%20Consultorio%20MG!5e0!3m2!1ses-419!2smx!4v1739333868365!5m2!1ses-419!2smx"
        allowfullscreen=""
        loading="lazy"
        style="border: 0;"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
      </div>  
      <Fragment>
        <div style="margin-top: 30px; display: flex; gap: 20px; justify-content: center; align-items: flex-start;">
          <!-- Columna izquierda -->
          <div style="flex: 1; text-align: center;">
            <!-- Imagen -->
            <img src="/images/tiempo.png" alt="Imagen" style="display: block; margin: 0 auto 15px; max-width: 100px; height: auto;">
          
            <!-- Subtítulo en negritas -->
            <p style="font-weight: bold; margin-bottom: 10px;">Horario</p>
          
            <!-- Lista de frases -->
            <ul style="list-style-type: none; margin: 0; padding: 0;">
              <li>Servicio las 24 Horas.</li>
            </ul>
          </div>
          
          <!-- Columna derecha -->
          <div style="flex: 1; text-align: center;">
            <!-- Imagen -->
            <img src="/images/ubica.png" alt="Imagen" style="display: block; margin: 0 auto 15px; max-width: 100px; height: auto;">
          
            <!-- Subtítulo en negritas -->
            <p style="font-weight: bold; margin-bottom: 10px;">Localización</p>
          
            <!-- Lista de frases -->
            <ul style="list-style-type: none; margin: 0; padding: 0;">
              <li>Av. Adolf Bernard Horn Junior, Tlaquepaque, 45654 San Pedro Tlaquepaque, Jal.</li>
            </ul>
          </div>
        </div>
          
      </Fragment>
  </WidgetWrapper>
  

